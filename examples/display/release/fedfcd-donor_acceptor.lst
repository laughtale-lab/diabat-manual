@\examplenum{fedfcd-donor-acceptor}@
## This is an example of the input file for @\textcolor{mygreen}{\$}@diabat-fedfcd job.
## Diabatization including 4 electronic excited states (from TDDFT) for asymmetric donor-acceptor system

# Multistate FED-FCD job block
$diabat-fedfcd

  # mo and electronic state files
  $$statepack
    mofile = "PATH_of_diabat/data/donor_acceptor/donor_acceptor.fchk"
    statefile = "PATH_of_diabat/data/donor_acceptor/donor_acceptor.log"
    state_index = 1..4  # include the first 4 excited states for diabatization
  $$

  # fragment definition
  $$<frag>
    num_frag = 2
    frag 1 = 1..10
    frag 2 = 11..14
  $$

$ # end of Multistate FED-FCD job block

