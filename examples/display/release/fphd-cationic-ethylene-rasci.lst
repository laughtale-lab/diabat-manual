@\examplenum{fphd-cationic-ethylene-rasci}\enlargethispage{2\baselineskip}@
## This is an example of the input file for @\textcolor{mygreen}{\$}@diabat-fphd job.
## Hole transfer coupling in a cationic asymmetric ethylene dimer based on RASCI calculations

# FPHD job block
$diabat-fphd

  # mo and electronic state files
  $$statepack

    num_state_pack = 2

    $$$statepack-1
      mofile = "PATH_of_diabat/data/asymmetric_ethylene_dimer/rasci/neutral.in.fchk"
      statefile = "PATH_of_diabat/data/asymmetric_ethylene_dimer/rasci/neutral.out"
      state_index = 1  # read the ground state of the neutral system as the reference state
    $$$

    $$$statepack-2
      mofile = "PATH_of_diabat/data/asymmetric_ethylene_dimer/rasci/cationic.in.fchk"
      statefile = "PATH_of_diabat/data/asymmetric_ethylene_dimer/rasci/cationic.out"
      state_index = 1..2  # include the first 2 doublet states for diabatization
    $$$

  $$

  # fragment definition
  $$<frag>
    num_frag = 2
    frag 1 = 1..6
    frag 2 = 7..12
  $$

  refid = 1  # set the first state in reading order (the neutral ground state) as the reference state
  multiexcite = .true.  ## turn on multi-excitation implementation for charged systems
  partition = "mulliken"

$ # end of FPHD job block

