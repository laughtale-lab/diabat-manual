@\examplenum{fphd-water-triplet-rasci}@
## This is an example of the input file for @\textcolor{mygreen}{\$}@diabat-fphd job.
## Diabatization including 20 triplet states (from RASCI) for water dimer
## Multi-excitation implementation is activated automatically
## The singlet ground state is set as the reference state

# FPHD job block
$diabat-fphd

  # mo and state files
  $$statepack

    # there are two state packs, one for singlets and the other for triplets
    num_state_pack = 2

    # the first state pack (singlet states)
    $$$statepack-1
      mofile = "PATH_of_diabat/data/water_dimer_rasci/singlet/water_singlet.fchk"
      statefile = "PATH_of_diabat/data/water_dimer_rasci/singlet/water_singlet.out"
      # include the first state (ground state) as reference
      state_index = 1
    $$$

    # the second state pack (triplet states)
    $$$statepack-2
      mofile = "PATH_of_diabat/data/water_dimer_rasci/triplet/water_triplet.fchk"
      statefile = "PATH_of_diabat/data/water_dimer_rasci/triplet/water_triplet.out"
      # include the first 20 triplet states for diabatization
      state_index = 1..20
    $$$

  $$

  # fragment definition
  $$<frag>
    num_frag = 2
    frag 1 = 1..3
    frag 2 = 4..6
  $$

  # set the first state (in reading order) as reference state
  refid = 1

$ # end of FPHD job block

