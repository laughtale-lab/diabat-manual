@\examplenum{postwfn-hole-particle-ethylene-adia}@
## This is an example of the input file for @\textcolor{mygreen}{\$}@postwfn
## Generate hole and particle density cube files for ethylene dimer singlet excited states
## The ground state is automatically set as reference

# electronic state wavefunction post-processing job block
$postwfn

  # mo and state files
  $$statepack

    mofile = "PATH_of_diabat/data/ethylene_tddft/dimer/ethylene_dimer.fchk"
    statefile = "PATH_of_diabat/data/ethylene_tddft/dimer/ethylene_dimer.log"
    state_index = 1..4  # Example format: 1, 2:5, 6..10, 13:19:2

  $$

  hole_dens = .true.  # calculate hole density and print in cube file format
  particle_dens = .true.  # calculate particle density and print in cube file format

$

