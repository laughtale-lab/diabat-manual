@\examplenum{tutorial-cation-doublet}@
### cationic trimer

$diabat-fphd

  $$statepack
    num_state_pack = 2

    $$$statepack-1
      mofile = "../casscf/neutral-66/orca.molden.input"
      statefile = "../casscf/neutral-66/orca.log"
      state_index = 1
    $$$

    $$$statepack-2
      mofile = "../casscf/cationic-doublet-56-nroot-12/orca.molden.input"
      statefile = "../casscf/cationic-doublet-56-nroot-12/orca.log"
      state_index = 1..12
    $$$
  $$

  $$<frag>
    num_frag = 3
    frag 1 = 1..30
    frag 2 = 31..60
    frag 3 = 61..90
  $$

  multiexcite = .true.
  refid = 1
  density_cube = .true.

  refnp = 0.6, 0.6, 0.6
  refnh = 0.6, 0.6, 0.6
  print_spin_fphn = .true.

$
