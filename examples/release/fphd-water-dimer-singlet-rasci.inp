## This is an example of the input file for $diabat-fphd job.
## Diabatization including 20 singlet excited states (from RASCI) for water dimer
## Multi-excitation implementation is activated
## The singlet ground state is set as the reference state

# FPHD job block
$diabat-fphd

  # mo and state files
  $$statepack

    mofile = "PATH_of_diabat/data/water_dimer_rasci/singlet/water_singlet.fchk"
    statefile = "PATH_of_diabat/data/water_dimer_rasci/singlet/water_singlet.out"

    # read 21 electronic states, where the first one is the ground state (reference
    # state), and the other 20 are singlet excited states for diabatization
    state_index = 1..21

  $$

  # fragment definition
  $$frag
    num_frag = 2
    frag 1 = 1..3
    frag 2 = 4..6
  $$

  # activate multi-excitation implementation
  multiexcite = .true.
  # set the first state (in reading order) as reference state
  refid = 1

$ # end of FPHD job block

