## This is an example of the input file for diabat program.
## The symbol # represents comment.


# diabatization by FPHD method
$diabat-fphd

  $$statepack
    mofile = "../rasci/ABCD.inp.fchk"
    statefile = "../rasci/ABCD.out"
    state_index = 1:31  # Example format: 1, 2..5, 6..10
  $$

  $$frag
      num_frag = 4
      frag 1 = 1..36  # Example format: 1,2, 3..7, 8, 13..15
      frag 2 = 37..72
      frag 3 = 73..108
      frag 4 = 109..144
  $$

  refid = 1  # the ground state is set as reference
  multiexcite = .true.  
  density_cube = .true.  # print detachment and attachment densities in cube format
 
$
